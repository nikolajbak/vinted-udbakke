+const MIN_TIMER = 1;
+
+function historikFil(): string {
+  const path = require("path") as { join: (...p: string[]) => string };
+  const os = require("os") as { homedir: () => string };
+  return process.env.VINTED_HISTORIK?.trim() || path.join(os.homedir(), ".local", "share", "vinted-mcp", "historik.jsonl");
+}
+
+interface Billede { tid: number; query: string; hjerter: Record<string, number>; }
+
+function forrige(fil: string, query: string, nu: number): Billede | null {
+  const fs = require("fs") as any;
+  if (!fs.existsSync(fil)) return null;
+  let fundet: Billede | null = null;
+  for (const linje of fs.readFileSync(fil, "utf8").split("\n")) {
+    if (!linje.trim()) continue;
+    try {
+      const b = JSON.parse(linje) as Billede;
+      if (b.query === query && nu - b.tid >= MIN_TIMER * 3600000) fundet = b;
+    } catch {
+      // En halv linje fra et afbrudt skriv tæller ikke.
+    }
+  }
+  return fundet;
+}
+
+function gem(fil: string, billede: Billede): void {
+  const fs = require("fs") as any;
+  const path = require("path") as any;
+  fs.mkdirSync(path.dirname(fil), { recursive: true });
+  fs.appendFileSync(fil, JSON.stringify(billede) + "\n");
+}
