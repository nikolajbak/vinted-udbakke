diff --git a/src/tools/marked.ts b/src/tools/marked.ts
new file mode 100644
index 0000000..8297c15
--- /dev/null
+++ b/src/tools/marked.ts
@@ -0,0 +1,50 @@
+import type { VintedAPIClient } from "../vinted-core";
+
+// Vinteds søgning svarer på sessionens marked, uanset domæne (målt 5. november:
+// dk, de og fr gav de samme 96 varer i DKK). Derfor kun Danmark.
+export const LAND = "dk";
+const PR_SIDE = 96;
+
+const STANDE: Array<[RegExp, string]> = [
+  [/neuf avec|ny med|new with/i, "Ny med prismærke"],
+  [/neuf sans|ny uden|new without/i, "Ny uden prismærke"],
+  [/très bon|meget god|very good/i, "Meget god"],
+  [/bon état|^god$|good/i, "God"],
+  [/satisfaisant|tilfreds|satisfactory/i, "Tilfredsstillende"]
+];
+
+export function dansk(stand: unknown): string {
+  const tekst = String(stand || "");
+  for (const [re, navn] of STANDE) {
+    if (re.test(tekst)) return navn;
+  }
+  return tekst || "Ukendt";
+}
+
+/** Annoncer på markedet: fremhævede er betalt plads, ikke relevans, og sorteres fra. */
+export async function hentMarked(client: VintedAPIClient, query: string, sider: number, categoryId?: number) {
+  const items: any[] = [];
+  const set = new Set<number>();
+  let total = 0;
+  let fremhaevet = 0;
+  for (let page = 1; page <= sider; page++) {
+    const svar: any = await client.searchItems({ query, country: LAND, categoryId, perPage: PR_SIDE, page, sortBy: "relevance" });
+    total = svar.totalCount || total;
+    for (const item of svar.items) {
+      if (set.has(item.id)) continue;
+      set.add(item.id);
+      if (item.promoted) fremhaevet++;
+      else items.push(item);
+    }
+    if (!svar.hasMore) break;
+  }
+  return { items, total, fremhaevet };
+}
+
+export function fraktil(sorteret: number[], p: number): number {
+  if (!sorteret.length) return 0;
+  const pos = (sorteret.length - 1) * p;
+  const lav = Math.floor(pos);
+  const hoej = Math.ceil(pos);
+  return Math.round(sorteret[lav] + (sorteret[hoej] - sorteret[lav]) * (pos - lav));
+}
diff --git a/src/tools/price-lookup.ts b/src/tools/price-lookup.ts
new file mode 100644
index 0000000..ea6ae8e
--- /dev/null
+++ b/src/tools/price-lookup.ts
@@ -0,0 +1,64 @@
+import type { VintedAPIClient } from "../vinted-core";
+import { dansk, fraktil, hentMarked } from "./marked";
+
+export const priceLookupTool = {
+  name: "price_lookup",
+  description:
+    "Prisopslag på det danske Vinted: median, kvartiler og antal for en søgning, delt på stand, uden fremhævede annoncer. " +
+    "Tallene er aktive udbudspriser, ikke salgspriser. Pris er sælgerens pris uden køberbeskyttelse.",
+  inputSchema: {
+    type: "object",
+    properties: {
+      query: { type: "string", description: "Søgeord, fx 'Ganni kjole'" },
+      brand: { type: "string", description: "Kun dette mærke (eksakt, uanset store/små bogstaver)" },
+      size: { type: "string", description: "Kun denne størrelse (eksakt, fx 'M' eller 'EU 36')" },
+      condition: { type: "string", description: "Kun denne stand: Ny med prismærke, Ny uden prismærke, Meget god, God, Tilfredsstillende" },
+      pages: { type: "integer", description: "Sider à 96 annoncer (1-3)", default: 2 }
+    },
+    required: ["query"]
+  }
+};
+
+// Vinted skriver »EU 36« med et hårdt mellemrum, og nogle gange med et almindeligt.
+const norm = (v: unknown) => String(v || "").replace(/\s+/g, " ").trim().toLowerCase();
+const stoerrelse = (v: unknown) => norm(v).replace(/^eu /, "");
+const ens = (a: unknown, b: unknown) => norm(a) === norm(b);
+
+export function prisTal(priser: number[]) {
+  const s = [...priser].sort((a, b) => a - b);
+  return { antal: s.length, min: s[0] ?? 0, q1: fraktil(s, 0.25), median: fraktil(s, 0.5), q3: fraktil(s, 0.75), max: s[s.length - 1] ?? 0 };
+}
+
+export async function handlePriceLookup(client: VintedAPIClient, args: any): Promise<string> {
+  const sider = Math.max(1, Math.min(Number(args.pages) || 2, 3));
+  const { items, total, fremhaevet } = await hentMarked(client, args.query, sider);
+  const valgte = items.filter(
+    (i: any) =>
+      i.currency === "DKK" && i.price > 0 &&
+      (!args.brand || ens(i.brand, args.brand)) &&
+      (!args.size || stoerrelse(i.size) === stoerrelse(args.size)) &&
+      (!args.condition || ens(dansk(i.condition), args.condition))
+  );
+  const stande: Record<string, number[]> = {};
+  for (const i of valgte as any[]) (stande[dansk(i.condition)] ||= []).push(i.price);
+
+  return JSON.stringify(
+    {
+      query: args.query,
+      valuta: "DKK",
+      note: "Aktive udbudspriser på vinted.dk, ikke salgspriser.",
+      traeffPaaVinted: total,
+      hentet: items.length + fremhaevet,
+      fremhaevetFrasorteret: fremhaevet,
+      brugt: valgte.length,
+      pris: prisTal(valgte.map((i: any) => i.price)),
+      prisPrStand: Object.fromEntries(Object.entries(stande).map(([k, v]) => [k, prisTal(v)])),
+      mestEftertragtede: [...(valgte as any[])]
+        .sort((a, b) => b.favouriteCount - a.favouriteCount)
+        .slice(0, 5)
+        .map((i) => ({ hjerter: i.favouriteCount, pris: i.price, titel: i.title, stand: dansk(i.condition), url: i.url }))
+    },
+    null,
+    2
+  );
+}
